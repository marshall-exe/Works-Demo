# Public build-time settings. Copy to the Vercel project environment for production.
# Real site URL for canonical, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://oca-hermes-homepage.vercel.app
# Set to true ONLY for the approved production domain. Anything else stays noindex.
NEXT_PUBLIC_INDEX=false
# Calendly (or any booking URL). Empty = the contact dialog with the oneclickaway.io booking link.
NEXT_PUBLIC_CALENDLY_URL=
# Lead capture: an HTTPS endpoint that accepts POST JSON {name, whatsapp, industry, source, page}.
# "demo" shows the form and simulates success (preview only). Empty hides the form.
NEXT_PUBLIC_LEAD_ENDPOINT=demo
# Newsletter endpoint (POST JSON {email, source}). Empty hides the form.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
